{
  "name": "msagent",
  "displayName": "msAgent",
  "description": "Agentic auto-fix for mssanitizer Ascend NPU operator memory errors",
  "version": "0.3.0",
  "publisher": "msagent",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Testing"
  ],
  "activationEvents": [
    "onLanguage:cpp",
    "onCommand:msagent.parseLog",
    "onCommand:msagent.fixProblem",
    "onCommand:msagent.fixAll",
    "onCommand:msagent.getAiFixQueueStates",
    "onCommand:msagent.testWebview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "msagent.parseLog",
        "title": "msAgent: Parse Log File",
        "icon": "$(file-text)"
      },
      {
        "command": "msagent.fixProblem",
        "title": "msAgent: Fix Problem by Index"
      },
      {
        "command": "msagent.getAiFixQueueStates",
        "title": "msAgent: Get AI Fix Queue States"
      },
      {
        "command": "msagent.fixAll",
        "title": "msAgent: Fix All Issues",
        "icon": "$(beaker)"
      },
      {
        "command": "msagent.clearDiagnostics",
        "title": "msAgent: Clear Diagnostics",
        "icon": "$(clear-all)"
      },
      {
        "command": "msagent.openSettings",
        "title": "msAgent: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "msagent.testWebview",
        "title": "msAgent: Test WebView",
        "icon": "$(check)"
      }
    ],
    "configuration": {
      "title": "msAgent",
      "properties": {
        "msagent.modelEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "LLM API endpoint URL (OpenAI-compatible, e.g. Ollama, vLLM)"
        },
        "msagent.modelName": {
          "type": "string",
          "default": "qwen3:8b",
          "description": "Model name (e.g. qwen3:8b for Ollama)"
        },
        "msagent.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for cloud providers. Leave empty for local providers like Ollama."
        },
        "msagent.temperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 2,
          "description": "LLM temperature for fix generation"
        },
        "msagent.maxTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 256,
          "maximum": 32768,
          "description": "Max tokens for LLM response"
        },
        "msagent.timeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 30000,
          "maximum": 600000,
          "description": "LLM request timeout in milliseconds (default: 5 minutes for complex fixes)"
        },
        "msagent.provider": {
          "type": "string",
          "enum": [
            "openai-compatible",
            "opencode"
          ],
          "default": "openai-compatible",
          "description": "Fix backend provider: openai-compatible uses your configured LLM with tool calling, opencode delegates to OpenCode CLI"
        },
        "msagent.agentMode": {
          "type": "string",
          "enum": [
            "builtin",
            "opencode"
          ],
          "default": "builtin",
          "description": "(Deprecated: use provider instead) Fix agent mode: builtin uses your configured LLM with tool calling, opencode delegates to OpenCode CLI"
        },
        "msagent.opencodeMode": {
          "type": "string",
          "enum": [
            "cli",
            "server"
          ],
          "default": "cli",
          "description": "OpenCode execution mode: cli runs opencode CLI directly, server connects to an opencode server"
        },
        "msagent.opencodeServePort": {
          "type": "number",
          "default": 7325,
          "description": "Port for OpenCode server mode"
        },
        "msagent.opencodeCliPath": {
          "type": "string",
          "default": "opencode",
          "description": "Path to OpenCode CLI executable (only used when provider is opencode)"
        },
        "msagent.opencodeApiEndpoint": {
          "type": "string",
          "default": "http://localhost:7325",
          "description": "OpenCode API endpoint for server mode"
        },
        "msagent.opencodeApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for OpenCode server mode"
        }
      }
    },
    "keybindings": [
      {
        "command": "msagent.parseLog",
        "key": "Ctrl+Alt+L",
        "mac": "Cmd+Alt+L",
        "when": "editorTextFocus"
      },
      {
        "command": "msagent.fixAll",
        "key": "Ctrl+Alt+F",
        "mac": "Cmd+Alt+F",
        "when": "editorTextFocus"
      },
      {
        "command": "msagent.clearDiagnostics",
        "key": "Ctrl+Alt+C",
        "mac": "Cmd+Alt+C"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "mocha",
    "test:coverage": "c8 mocha",
    "package": "npm run compile && npx vsce package --baseContentUrl https://gitcode.com/yangchenhua/ms-agent/raw/main/ --baseImagesUrl https://gitcode.com/yangchenhua/ms-agent/raw/main/"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/sinon": "^21.0.1",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.0",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "sinon": "^21.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "claude-code": "^1.0.0"
  }
}
