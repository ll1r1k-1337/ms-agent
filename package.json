{
  "name": "msagent",
  "displayName": "msAgent",
  "description": "Agentic auto-fix for mssanitizer Ascend NPU operator memory errors",
  "version": "0.5.1",
  "publisher": "msagent",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Testing"
  ],
  "activationEvents": [
    "onLanguage:cpp",
    "onCommand:msagent.parseLog",
    "onCommand:msagent.fixProblem",
    "onCommand:msagent.fixAll",
    "onCommand:msagent.selectModel",
    "onCommand:msagent.openSettings",
    "onCommand:msagent.getAiFixQueueStates"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "msagent.parseLog",
        "title": "msAgent: Parse Log File",
        "icon": "$(file-text)"
      },
      {
        "command": "msagent.fixProblem",
        "title": "msAgent: Fix Problem by Index"
      },
      {
        "command": "msagent.getAiFixQueueStates",
        "title": "msAgent: Get AI Fix Queue States"
      },
      {
        "command": "msagent.fixAll",
        "title": "msAgent: Fix All Issues",
        "icon": "$(beaker)"
      },
      {
        "command": "msagent.selectModel",
        "title": "msAgent: Select OpenCode Model",
        "icon": "$(server-environment)"
      },
      {
        "command": "msagent.openSettings",
        "title": "msAgent: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "msagent.clearDiagnostics",
        "title": "msAgent: Clear Diagnostics",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": {
      "title": "msAgent",
      "properties": {
        "msagent.modelName": {
          "type": "string",
          "default": "opencode/minimax-m2.5-free",
          "markdownDescription": "OpenCode full model ID used for repair sessions. On first activation, msAgent will try to sync this value from your workspace or user OpenCode config. This setting remains a free-form string because VS Code settings do not support runtime-populated dropdowns. Use **msAgent: Select OpenCode Model** to choose from the models discovered in your OpenCode config files."
        },
        "msagent.timeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 30000,
          "maximum": 600000,
          "description": "Timeout for a single OpenCode repair session in milliseconds."
        },
        "msagent.opencodeServePort": {
          "type": "number",
          "default": 4096,
          "description": "Port used by the OpenCode server flow."
        },
        "msagent.opencodeCliPath": {
          "type": "string",
          "default": "opencode",
          "description": "Path to the OpenCode executable used for `opencode serve`."
        }
      }
    },
    "keybindings": [
      {
        "command": "msagent.parseLog",
        "key": "Ctrl+Alt+L",
        "mac": "Cmd+Alt+L",
        "when": "editorTextFocus"
      },
      {
        "command": "msagent.fixAll",
        "key": "Ctrl+Alt+F",
        "mac": "Cmd+Alt+F",
        "when": "editorTextFocus"
      },
      {
        "command": "msagent.clearDiagnostics",
        "key": "Ctrl+Alt+C",
        "mac": "Cmd+Alt+C"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "mocha --exclude 'test/integration/localOpencode.integration.test.ts'",
    "test:integration": "mocha --spec 'test/integration/**/*.test.ts'",
    "test:coverage": "c8 mocha --exclude 'test/integration/localOpencode.integration.test.ts'",
    "package": "npm run compile && npx vsce package --baseContentUrl https://gitcode.com/yangchenhua/ms-agent/raw/main/ --baseImagesUrl https://gitcode.com/yangchenhua/ms-agent/raw/main/"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/sinon": "^21.0.1",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vscode/test-electron": "^2.3.0",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "eslint": "^9.39.4",
    "mocha": "^11.7.5",
    "proxyquire": "^2.1.3",
    "sinon": "^21.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.59.0"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.14.39",
    "@types/marked": "^5.0.2",
    "claude-code": "^1.0.0",
    "clean": "^4.0.2",
    "marked": "^18.0.2"
  }
}
